{
  "name": "magic-massage-natali",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "content:import": "tsx --env-file=.env.local scripts/content/import-public-content.ts",
    "media:inventory": "node scripts/media/scan-media-inventory.mjs",
    "media:inventory:check": "node scripts/media/scan-media-inventory.mjs --check",
    "dev": "next dev",
    "dev:host": "next dev -H 0.0.0.0",
    "dev:e2e": "next dev -H 127.0.0.1 -p 3100",
    "dev:e2e:admin-auth": "next dev -H 127.0.0.1 -p 3101",
    "preview": "next build && next start -H 0.0.0.0 -p 3001",
    "preview:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare preview",
    "build:cloudflare": "cross-env CLOUDFLARE_FREE_BUILD=true opennextjs-cloudflare build",
    "deploy:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare deploy",
    "upload:cloudflare": "npm run build:cloudflare && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "share": "powershell -ExecutionPolicy Bypass -File scripts/share-cloudflare.ps1",
    "share:dev": "powershell -ExecutionPolicy Bypass -Command \"$env:PORT='3000'; ./scripts/share-cloudflare.ps1\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:e2e": "npm run test:e2e:ui && npm run test:e2e:admin-auth",
    "test:e2e:ui": "playwright test --config playwright.config.ts",
    "test:e2e:admin-auth": "node scripts/run-admin-auth-e2e.mjs",
    "test:e2e:admin-auth:required": "node scripts/run-admin-auth-e2e.mjs --required",
    "test:booking-db": "node --env-file=.env.local scripts/verify-booking-db.mjs"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@supabase/supabase-js": "^2.110.1",
    "@tiptap/extension-image": "^3.27.4",
    "@tiptap/extension-link": "3.27.4",
    "@tiptap/extension-text-align": "3.27.4",
    "@tiptap/extension-text-style": "^3.27.4",
    "@tiptap/extension-underline": "3.27.4",
    "@tiptap/react": "3.27.4",
    "@tiptap/starter-kit": "3.27.4",
    "image-size": "2.0.2",
    "next": "16.2.12",
    "pdfmake": "^0.3.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanitize-html": "2.17.6",
    "server-only": "^0.0.1",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.24",
    "undici": "7.28.0"
  }
}
