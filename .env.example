NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin platform data source. Service role key is server-only and required for
# Supabase Auth invitations / role profile writes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional real-auth Playwright smoke. Use a dedicated active admin test user;
# these values stay server/test-runner only and must never use NEXT_PUBLIC_.
E2E_ADMIN_AUTH_REQUIRED=false
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Gift certificate payments stay in demo mode unless Stripe keys are configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live gift certificate payments require both flags and final code prices.
GIFT_CERTIFICATES_ENABLE_LIVE_PAYMENTS=false
GIFT_CERTIFICATES_FINAL_PRICES_CONFIRMED=false

# Transactional email. RESEND_FROM_EMAIL must be a verified sender; Reply-To,
# the owner notification address, and review URL are configured in admin settings.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Mirror this value into Supabase Vault as `email_worker_secret`; store the full
# production worker endpoint separately as Vault secret `email_worker_url`.
EMAIL_WORKER_SECRET=
EMAIL_PREFERENCES_SECRET=
