NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin platform data source. Service role key is server-only and required for
# Supabase Auth invitations / role profile writes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional real-auth Playwright smoke. Use a dedicated active admin test user;
# these values stay server/test-runner only and must never use NEXT_PUBLIC_.
E2E_ADMIN_AUTH_REQUIRED=false
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Gift certificate payments stay in demo mode unless Stripe keys are configured.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Live gift certificate payments require both flags and final code prices.
GIFT_CERTIFICATES_ENABLE_LIVE_PAYMENTS=false
GIFT_CERTIFICATES_FINAL_PRICES_CONFIRMED=false

# Resend is the preferred low-cost v1 email provider.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GIFT_CERTIFICATES_OWNER_EMAIL=
